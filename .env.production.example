# ============================================================
# VARIABLES PARA PRODUCCIÓN — Contabily
# ============================================================
#
# Esta es la plantilla que hay que pegar en Render → Environment.
# No es un .env real: los valores van en el panel de Render, nunca en git.
#
# Orden de uso:
#   1. Crear el proyecto en Supabase y copiar el connection string
#   2. Pegar las variables de AQUÍ en Render
#   3. Correr las migraciones una vez contra Supabase
#
# ------------------------------------------------------------
# A) REQUERIDAS — sin ellas la app no arranca bien
# ------------------------------------------------------------

# ⚠️ Del panel de Supabase: Settings → Database → Connection string → URI
#     Usar el "Direct connection" (puerto 5432), NO el pooler (6543).
#     El pooler va con pgbouncer en modo transacción y rompe las migraciones
#     de TypeORM, que se ejecutan dentro de una transacción.
DATABASE_URL=postgresql://postgres.xyz:clave@db.TU-PROYECTO.supabase.co:5432/postgres

# Secreto para firmar los access tokens. Mínimo 32 caracteres aleatorios.
# Generar con: openssl rand -base64 48
JWT_SECRET=genera-aqui-un-secreto-largo-aleatorio-de-32-o-mas-caracteres

# Igual que el anterior pero DISTINTO. Si son iguales, la separación entre
# access y refresh token deja de tener sentido.
JWT_REFRESH_SECRET=genera-aqui-otro-secreto-largo-aleatorio-distinto-al-anterior


# ------------------------------------------------------------
# B) LAS PONE RENDER SOLO — no las definas a menos que sepas por qué
# ------------------------------------------------------------
# Render asigna el puerto donde debe escuchar y lo expone en PORT.
# Fijarla a mano es la forma más común de que el deploy falle con
# "no se pudo conectar al puerto".
#PORT=3000

# Render lo pone en production por ti.
#NODE_ENV=production


# ------------------------------------------------------------
# C) RECOMENDADAS
# ------------------------------------------------------------

# Origen permitido por CORS. Al no haber frontend todavía, apunta a la propia
# app para que Swagger (que corre en el mismo origen) no se vea afectado.
# Si luego levantas el frontend, cambia esto a su URL.
FRONTEND_URL=https://TU-SERVICIO.onrender.com

# Prefijo del API. Tiene este valor por defecto, solo cámbialo si lo cambias.
API_PREFIX=api/v1


# ------------------------------------------------------------
# D) OPCIONALES
# ------------------------------------------------------------

# --- Supabase Auth -------------------------------------------------
# NO hace falta. La app arranca en modo auth local contra la misma base de
# Supabase (register/login funcionan sin tocar nada). Solo se necesitan estas
# tres si quieres delegar el login en Supabase Auth.
#SUPABASE_URL=https://TU-PROYECTO.supabase.co
#SUPABASE_ANON_KEY=
#SUPABASE_SERVICE_ROLE_KEY=

# --- Redis ---------------------------------------------------------
# En la práctica se ignora: RedisModule resuelve siempre con un almacén
# in-memory, así que la blacklist de tokens vive en memoria y se pierde al
# reiniciar. Aceptable para una demo. No montes un Redis por esto.
#REDIS_URL=redis://localhost:6379

# --- Conexión por variables sueltas --------------------------------
# Alternativa a DATABASE_URL. Solo se usan si DATABASE_URL NO está definida.
# Si defines DATABASE_URL, estas se ignoran.
#DB_HOST=localhost
#DB_PORT=5432
#DB_USERNAME=postgres
#DB_PASSWORD=
#DB_NAME=postgres

# ⚠️ JAMÁS en producción. synchronize=true hace que TypeORM altere el esquema
# por su cuenta y puede borrar columnas. Las migraciones son el camino.
#DB_SYNCHRONIZE=false
#DB_LOGGING=false

# --- Google OAuth --------------------------------------------------
# Solo si habilitas "Continuar con Google". El callback debe apuntar a la URL
# pública de Render y estar dado de alta en Google Cloud Console.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_CALLBACK_URL=https://TU-SERVICIO.onrender.com/api/v1/auth/google/callback

# --- Límite de peticiones ------------------------------------------
# Por defecto 100 peticiones cada 60 s por cliente.
#SECURITY_RATE_LIMIT_TTL=60000
#SECURITY_RATE_LIMIT_LIMIT=100
